{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@cloneforge/ai": ["packages/ai/src"],
      "@cloneforge/config": ["packages/config/src"],
      "@cloneforge/crawler": ["packages/crawler/src"],
      "@cloneforge/database": ["packages/database/src"],
      "@cloneforge/deployment": ["packages/deployment/src"],
      "@cloneforge/ui": ["packages/ui/src"]
    }
  }
}
