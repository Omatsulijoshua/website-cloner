{
    "name":  "cloneforge-ai",
    "private":  true,
    "version":  "0.1.0",
    "description":  "Production-oriented AI website cloning platform with safe capture, AI correction, and optional backend generation.",
    "scripts":  {
                    "dev":  "turbo dev",
                    "build":  "turbo build",
                    "lint":  "turbo lint",
                    "typecheck":  "turbo typecheck",
                    "format":  "prettier --write .",
                    "db:generate":  "prisma generate --schema packages/database/prisma/schema.prisma",
                    "db:migrate":  "prisma migrate dev --schema packages/database/prisma/schema.prisma",
                    "dev:web":  "npm run dev --workspace @cloneforge/web",
                    "dev:admin":  "npm run dev --workspace @cloneforge/admin",
                    "desktop:dev":  "npm run dev --workspace @cloneforge/desktop",
                    "desktop:pack":  "npm run pack --workspace @cloneforge/desktop",
                    "desktop:dist:win":  "npm run dist:win --workspace @cloneforge/desktop"
                },
    "workspaces":  [
                       "apps/*",
                       "packages/*"
                   ],
    "devDependencies":  {
                            "@types/node":  "^20.14.10",
                            "prettier":  "^3.3.2",
                            "turbo":  "^2.0.6",
                            "typescript":  "^5.5.3"
                        },
    "engines":  {
                    "node":  "\u003e=20.11.0"
                }
}
